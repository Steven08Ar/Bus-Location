# Mapbox Configuration
MAPBOX_TOKEN=your_mapbox_token_here

# MQTT Configuration
MQTT_URL=mqtt://localhost:1883

# PostgreSQL Database Configuration (primary variables)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=unibus

# Backward compatibility (DB_* variables as fallback)
# These are optional - POSTGRES_* variables take precedence
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password_here
# DB_NAME=unibus

# Application Configuration
APP_PORT=3000
